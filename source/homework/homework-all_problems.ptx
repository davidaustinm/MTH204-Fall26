                        <md>
                            \{ {\vec x} \}_{\mathcal{B}}= \left[\begin{array}{c}2 \\ 2\end{array}\right], \ \{ {\vec y} \}_{\mathcal{B}}= \left[\begin{array}{c}-2 \\ -1\end{array}\right], \ \{ {\vec z} \}_{\mathcal{B}}= \left[\begin{array}{c}-1 \\ 2\end{array}\right]

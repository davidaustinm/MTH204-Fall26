<?xml version="1.0" encoding="UTF-8"?>

<worksheet>
    <title>Problem 10 - Written Homework</title>

    <page>
        <!-- Q10 Section 2.3 -->
        <exercise>
            <introduction>
                <p>
                    Consider the vectors <m>\uvec = \threevec{1}{0}{-1}</m>,
                    <m>\vvec = \threevec{0}{-1}{1}</m>, and
                    <m>\wvec = \threevec{2}{-3}{1}</m>.
                </p>
            </introduction>

            <task>
                <statement>
                    <p>
                        Is <m>\bvec = \threevec{-5}{7}{-3}</m> in Span
                        <m>\{ \uvec, \vvec, \wvec \}</m>?
                        Why or why not?
                    </p>
                </statement>
            </task>

            <task>
                <statement>
                    <p>
                        Is <m>\cvec = \threevec{-5}{7}{-2}</m> in Span
                        <m>\{ \uvec, \vvec, \wvec \}</m>?
                        Why or why not?
                    </p>
                </statement>
            </task>

            <task>
                <statement>
                    <p>
                        Do the vectors <m>\uvec, \vvec, \wvec</m> span all of
                        <m>\mathbb{R}^3</m>?
                        Why or why not?
                    </p>
                </statement>
            </task>

            <task>
                <statement>
                    <p>
                        What is an important observation to make about the
                        relationship among <m>\uvec, \vvec, \wvec</m>?
                    </p>
                </statement>
            </task>

            <task>
                <statement>
                    <p>
                        Give a careful written description of Span
                        <m>\{ \uvec, \vvec, \wvec \}</m>.
                    </p>
                </statement>
            </task>
        </exercise>
    </page>
</worksheet>
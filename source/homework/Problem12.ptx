<?xml version="1.0" encoding="UTF-8"?>

<worksheet>
    <title>Problem 12 - Written Homework - MTH 204</title>

    <p>
        You should write up solutions neatly to all problems, making sure to
        show all your work and follow the homework policies (see Blackboard
        document for details).
        You will turn in the hand-written assignment in person during Wednesday
        class time.
        The solutions you turn in should be your own work and written in your
        own words.
        You cannot use any resources outside of discussing with your professor
        or classmates and/or your textbook.
        At the top of your first page of solutions, please list the names of any
        students who you worked with on the assignment.
        Don't forget to put your name at the top of the first page!
    </p>
    <!-- Q12 Section 2.3 -->
    <exercise>
        <introduction>
            <p>
                Suppose that we have the following collection of vectors in
                <m>\mathbb{R}^4</m>:
                <md>
                    {\vvec_1 = \fourvec{1}{1}{1}{1}, 
          \vvec_2 = \fourvec{\phantom{-}1}{\phantom{-}1}{-1}{-1}, 
          \vvec_3 = \fourvec{\phantom{-}1}{-1}{\phantom{-}1}{-1}}
                </md>.
            </p>
        </introduction>

        <task workspace="2in">
            <statement>
                <p>
                    Give an example of a nonzero vector <m>\wvec</m> that is not
                    equal to <m>\vvec_1</m>, <m>\vvec_2</m>, or <m>\vvec_3</m>
                    that belongs to the span of
                    <m>\{ \vvec_1, \vvec_2, \vvec_3 \}</m>.
                    Write a sentence to say why your vector has the desired
                    property.
                </p>
            </statement>
        </task>

        <task workspace="2in">
            <statement>
                <p>
                    Explain why Span <m>\{ \vvec_1, \vvec_2, \vvec_3 \}</m> is
                    not <m>\mathbb{R}^4</m> using pivots.
                </p>
            </statement>
        </task>

        <task workspace="2in">
            <statement>
                <p>
                    Find a vector <m>\vvec_4</m> so that <m>\vvec_4</m> is not
                    in Span <m>\{ \vvec_1, \vvec_2, \vvec_3 \}</m>, and clearly
                    justify why your vector has this property.
                </p>
            </statement>
        </task>

        <task workspace="2in">
            <statement>
                <p>
                    What can you say about Span
                    <m>\{ \vvec_1, \vvec_2, \vvec_3, \vvec_4 \}</m>?
                    Why?
                </p>
            </statement>
        </task>
    </exercise>
</worksheet>
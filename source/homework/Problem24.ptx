    <!-- Question 24 Section 3.4 -->
    <exercise>
        <statement>
            <p>
                Consider the matrix
                <m>A = \begin{bmatrix}-2 &amp; 1 &amp; k \\ 2 &amp; 3 &amp; 0 \\ 1 &amp; 2 &amp; 2 \\\end{bmatrix}</m>
                defined in terms of the parameter <m>k</m>.
                Compute <m>\det(A)</m>.
                Show your work.
            </p>
        </statement>
    </exercise>

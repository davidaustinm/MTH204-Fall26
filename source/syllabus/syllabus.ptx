    <subsection xml:id="sec-course-info">
        <title>Course Information</title>

        <p>
            This is the syllabus for
            <term>Linear Algebra (MATH 204, section xxx)</term> for Fall 2026.
            It is a 3 credit course.
            <!-- use a description list (dl) for short items -->
            <dl>
                <li>
                    <title>Instructor</title>

                    <p>
                        Prof.
                        Lastname, Office Location,
                        <url href="mailto:prof.lastname@example.edu">prof.lastname@example.edu</url>.
                    </p>
                </li>

                <li>
                    <title>Student Hours</title>


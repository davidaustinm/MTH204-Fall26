<?xml version="1.0" encoding="UTF-8"?>

<worksheet component="quiz">
    <title>Learning Target 1 Quiz - MTH 204</title>

    <p>
        This quiz covers course learning target #1.
        Read all <term>DIRECTIONS</term> carefully.
        Good luck!
    </p>
    <!-- Q1 Section 1.1 -->
    <exercise>
        <introduction>
            <p>
                (First attempt) I can execute the next 2-3 steps of Gaussian
                elimination by hand that are needed to work toward RREF (and
                recognize that additional steps are needed to achieve RREF),
                identify which row operations were used.
            </p>

            <p>
                A given linear system has been represented by an augmented
                matrix and Gaussian elimination has begun.
                The current state of the process is shown below.
            </p>
        </introduction>

        <task workspace="1in">
            <statement>
                <p>
                    Execute the next <term>two</term> row operations that you
                    would perform to continue the process of Gaussian
                    elimination, clearly stating your steps by writing the
                    explicit row operations you did.
                    You should write at least two additional matrices to show
                    your work.
                    <md>
                        \left[\begin{array}{ccc|c}
          1 \amp 7 \amp -2 \amp 12 \\
          0 \amp 2 \amp -4 \amp 6 \\
          0 \amp 3 \amp -5 \amp 10 \\
          \end{array}\right]
                    </md>
                </p>
            </statement>

            <solution>
                <p>
                    There are maybe other possible solutions, but below is the
                    most straightforward.
                    <md>
                        <mrow>
                  \left[\begin{array}{rrr|r} 
                    1 \amp 7 \amp -2 \amp 12 \\
                    0 \amp 2 \amp -4 \amp 6 \\
                    0 \amp 3 \amp -5 \amp 10 \\
                  \end{array}\right] \amp \xrightarrow{(\frac{1}{2})(R2) \to R2} \amp \left[\begin{array}{rrr|r} 
                    1 \amp 7 \amp -2 \amp 12 \\
                    0 \amp 1 \amp -2 \amp 3 \\
                    0 \amp 3 \amp -5 \amp 10 \\
                  \end{array}\right] 
                  </mrow>
                        <mrow>
                  \amp \xrightarrow{(R3 + (-3)R2) \to R3} \amp \left[\begin{array}{rrr|r} 
                    1 \amp 7 \amp -2 \amp 12 \\
                    0 \amp 1 \amp -2 \amp 3 \\
                    0 \amp 0 \amp 1 \amp 1 \\
                  \end{array}\right] 
                  </mrow>
                    </md>
                </p>
            </solution>
        </task>

        <task workspace="1in">
            <statement>
                <p>
                    Based on your final matrix, what would be the next row
                    operation you would execute to continue Gaussian
                    elimination?
                    Simply state the next row operation; you need not perform
                    it.
                </p>
            </statement>

            <solution>
                <p>
                    This will be a step to start the back substitution.
                    It is <m>2R3 + R2 \to R2</m>.
                </p>
            </solution>
        </task>
    </exercise>
</worksheet>
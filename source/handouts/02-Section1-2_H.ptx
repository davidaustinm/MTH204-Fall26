<?xml version="1.0" encoding="UTF-8"?>

<handout>
<title>Section 1.2 - Row Operations</title>

  <page>
    <p workspace="1in">
      You are given 7 systems of linear equations and 6 row operations. 
      Determine the order of the linear systems and identify which row
      operation takes you from one system to another.  You are unscrambling
      the process of Gaussian Elimination!
    </p>

<p> <term>Linear systems:</term>
    <md>
                        \begin{alignedat}{3}
    x \amp  {}+{}  \amp 2y \amp \amp \amp {}={}  \amp 4 \\
     \amp    \amp -3y \amp {}-{} \amp 3z \amp {}={}  \amp 3 \\
    -3x \amp  {}-{}  \amp 2y \amp {}+{} \amp z \amp {}={}  \amp -10 \\
  \end{alignedat} 
    </md>

    <md>
                        \begin{alignedat}{3}
    x \amp  {}+{}  \amp 2y \amp \amp \amp {}={}  \amp 4 \\
     \amp    \amp -3y \amp {}-{} \amp 3z \amp {}={}  \amp 3 \\
     \amp   \amp 4y \amp {}+{} \amp z \amp {}={}  \amp 2 \\
  \end{alignedat} 
    </md>

    <md>
                        \begin{alignedat}{3}
    x \amp  {}+{}  \amp 2y \amp \amp \amp {}={}  \amp 4 \\
     \amp    \amp y \amp {}+{} \amp z \amp {}={}  \amp -1 \\
     \amp   \amp 4y \amp {}+{} \amp z \amp {}={}  \amp 2 \\
  \end{alignedat} 
    </md>

    <md>
                        \begin{alignedat}{3}
    x \amp  {}+{}  \amp 2y \amp \amp \amp {}={}  \amp 4 \\
     \amp    \amp y \amp {}+{} \amp z \amp {}={}  \amp -1 \\
     \amp   \amp  \amp  \amp -3z \amp {}={}  \amp 6 \\
  \end{alignedat} 
    </md>

    <md>
                        \begin{alignedat}{3}
    x \amp  {}+{}  \amp 2y \amp \amp \amp {}={}  \amp 4 \\
     \amp    \amp y \amp {}+{} \amp z \amp {}={}  \amp -1 \\
     \amp   \amp  \amp  \amp z \amp {}={}  \amp -2 \\
  \end{alignedat} 
    </md>

    <md>
                        \begin{alignedat}{3}
    x \amp  {}+{}  \amp 2y \amp  {}={}  \amp 4 \\
     \amp    \amp     y \amp {}={}  \amp 1 \\
     \amp   \amp   z \amp {}={}  \amp -2 \\
  \end{alignedat} 
    </md>

    <md>
                        \begin{alignedat}{3}
     \amp x \amp  {}={}  \amp 2 \\
    \amp     y \amp {}={}  \amp 1 \\
      \amp   z \amp {}={}  \amp -2 \\
  \end{alignedat} 
    </md>
    </p>

    <p> <term>Row operations:</term>
        <md>
        R_3 + 3R_1 \rightarrow R_3
        </md>

    <md>
        -\frac{1}{3}R_2 \rightarrow R_2
        </md>

        <md>
        R_3 + (-4)R_2 \rightarrow R_3
        </md>

        <md>
        -\frac{1}{3}R_3 \rightarrow R_3
        </md>

<md>
        R_2 + (-1)R_3 \rightarrow R_2
        </md>

        <md>
        R_1 + (-2)R_2 \rightarrow R_1
        </md>

        </p>

  </page>
</handout>